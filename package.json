{
  "name": "base-ui-solid-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "test": "pnpm test:chromium",
    "test:_unit": "cross-env TZ=UTC vitest --project base-ui-solid --project @base-ui-solid/utils",
    "test:jsdom": "cross-env VITEST_ENV=jsdom pnpm test:_unit",
    "test:chromium": "cross-env VITEST_ENV=chromium pnpm test:_unit",
    "test:chromium:ui": "pnpm test:chromium --browser.headless=false",
    "test:firefox": "cross-env VITEST_ENV=firefox pnpm test:_unit",
    "test:firefox:ui": "pnpm test:firefox --browser.headless=false",
    "test:webkit": "cross-env VITEST_ENV=webkit pnpm test:_unit",
    "test:webkit:ui": "pnpm test:webkit --browser.headless=false",
    "test:browsers": "cross-env VITEST_ENV=all-browsers pnpm test:_unit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter playground dev",
    "test:compare-upstream": "node scripts/compareUpstreamTests.mjs",
    "prettier": "pretty-quick --ignore-path .lintignore --branch main",
    "prettier:all": "prettier --write . --ignore-path .lintignore"
  },
  "devDependencies": {
    "@floating-ui/utils": "^0.2.12",
    "@mui/internal-code-infra": "0.1.1-canary.4",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/web": "2.0.0-rc.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "5.0.3",
    "cross-env": "10.1.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "pretty-quick": "^4.2.2",
    "solid-js": "2.0.0-rc.13",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "^5.0.3"
  }
}
