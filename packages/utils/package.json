{
  "name": "@base-ui-solid/utils",
  "version": "0.0.1",
  "description": "A collection of Solid utility functions for Base UI Solid.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZerNico/base-ui-solid.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/ZerNico/base-ui-solid/issues"
  },
  "type": "module",
  "scripts": {
    "prebuild": "rimraf --glob build \"*.tsbuildinfo\"",
    "build": "node ../../scripts/buildPackage.mjs"
  },
  "exports": {
    "./platform": "./src/platform/index.ts",
    "./store": "./src/store/index.ts",
    "./*": "./src/*.ts",
    "./*.test": null,
    "./*.spec": null
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.13",
    "solid-js": "^2.0.0-rc.13"
  },
  "dependencies": {
    "@floating-ui/utils": "^0.2.12",
    "reselect": "^5.3.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build",
    "linkDirectory": false
  }
}
